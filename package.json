{
	"name": "discord-notify-action",
	"version": "1.0.2",
	"private": false,
	"description": "GitHub Action that send a message to a Discord channel.",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"keywords": [
		"github",
		"action",
		"discord",
		"notify",
		"notification",
		"message",
		"webhook",
		"ci/cd"
	],
	"homepage": "https://github.com/cabrera-evil/discord-notify-action",
	"bugs": {
		"url": "https://github.com/cabrera-evil/discord-notify-action/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/cabrera-evil/discord-notify-action"
	},
	"license": "MIT",
	"author": {
		"name": "cabrera-evil",
		"email": "info@cabrera-dev.com"
	},
	"maintainers": [
		{
			"name": "cabrera-evil",
			"email": "info@cabrera-dev.com"
		}
	],
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc --project tsconfig.build.json && tsc-alias --project tsconfig.build.json",
		"dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index",
		"start": "ts-node -r tsconfig-paths/register dist/index",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint --fix",
		"lint:check": "eslint",
		"lint:fix": "pnpm lint && pnpm format",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"check-types": "tsc --project tsconfig.build.json --noEmit",
		"prepare": "node .husky/install.mjs"
	},
	"dependencies": {
		"@actions/core": "^1.11.1",
		"@actions/github": "^6.0.1",
		"axios": "1.12.2",
		"joi": "^17.13.3",
		"lodash": "4.17.21"
	},
	"devDependencies": {
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@commitlint/format": "^19.8.1",
		"@eslint/compat": "^1.2.9",
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.28.0",
		"@eslint/json": "^0.13.1",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/jest": "^29.5.14",
		"@types/lodash": "^4.17.17",
		"@types/node": "^22.15.29",
		"@typescript-eslint/eslint-plugin": "^8.35.0",
		"conventional-changelog-atom": "^5.0.0",
		"conventional-changelog-conventionalcommits": "^9.0.0",
		"dotenv": "8.2.0",
		"eslint": "^9.28.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-prettier": "^5.4.1",
		"globals": "^15.15.0",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"lint-staged": "^15.5.2",
		"prettier": "^3.5.3",
		"prettier-plugin-organize-imports": "^4.1.0",
		"rimraf": "^6.0.1",
		"semantic-release": "^24.2.5",
		"semantic-release-export-data": "^1.1.0",
		"ts-jest": "^29.3.4",
		"ts-node": "^10.9.2",
		"ts-node-dev": "^2.0.0",
		"tsc-alias": "^1.8.16",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.33.0"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"packageManager": "pnpm@10.11.1"
}
